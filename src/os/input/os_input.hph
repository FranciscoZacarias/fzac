
@config
{
  @output_file_name `os_input`
  @output_path `../src/os/input/`
}

@table OS_Key_Table  (name windows_code linux_code)
{
  { Left_Mouse_Button   VK_LBUTTON             BTN_LEFT           }
  { Right_Mouse_Button  VK_RBUTTON             BTN_RIGHT          }
  { Middle_Mouse_Button VK_MBUTTON             BTN_MIDDLE         }
  { X1_Mouse_Button     VK_XBUTTON1            BTN_SIDE           }
  { X2_Mouse_Button     VK_XBUTTON2            BTN_EXTRA          }
  { Control_Break       VK_CANCEL              KEY_CANCEL         }
  { Backspace           VK_BACK                KEY_BACKSPACE      }
  { Tab                 VK_TAB                 KEY_TAB            }
  { Clear               VK_CLEAR               KEY_REDO           }
  { Enter               VK_RETURN              KEY_ENTER          }
  { Shift               VK_SHIFT               KEY_LEFTSHIFT      }
  { Ctrl                VK_CONTROL             KEY_LEFTCTRL       }
  { Alt                 VK_MENU                KEY_LEFTALT        }
  { Pause               VK_PAUSE               KEY_PAUSE          }
  { Caps_Lock           VK_CAPITAL             KEY_CAPSLOCK       }
  { Kana                VK_KANA                KEY_KATAKANA       }
  { Junja               VK_JUNJA               KEY_ZENKAKUHANKAKU }
  { Final               VK_FINAL               KEY_HENKAN         }
  { Hanja               VK_HANJA               KEY_HANGEUL        }
  { Escape              VK_ESCAPE              KEY_ESC            }
  { Space               VK_SPACE               KEY_SPACE          }
  { Page_Up             VK_PRIOR               KEY_PAGEUP         }
  { Page_Down           VK_NEXT                KEY_PAGEDOWN       }
  { End                 VK_END                 KEY_END            }
  { Home                VK_HOME                KEY_HOME           }
  { Left_arrow          VK_LEFT                KEY_LEFT           }
  { Up_arrow            VK_UP                  KEY_UP             }
  { Right_arrow         VK_RIGHT               KEY_RIGHT          }
  { Down_arrow          VK_DOWN                KEY_DOWN           }
  { Select              VK_SELECT              KEY_SELECT         }
  { Print               VK_PRINT               KEY_PRINT          }
  { Execute             VK_EXECUTE             KEY_EXECUTE        }
  { Print_Screen        VK_SNAPSHOT            KEY_SYSRQ          }
  { Insert              VK_INSERT              KEY_INSERT         }
  { Delete              VK_DELETE              KEY_DELETE         }
  { Help                VK_HELP                KEY_HELP           }
  { 0                   0x30                   KEY_0              }
  { 1                   0x31                   KEY_1              }
  { 2                   0x32                   KEY_2              }
  { 3                   0x33                   KEY_3              }
  { 4                   0x34                   KEY_4              }
  { 5                   0x35                   KEY_5              }
  { 6                   0x36                   KEY_6              }
  { 7                   0x37                   KEY_7              }
  { 8                   0x38                   KEY_8              }
  { 9                   0x39                   KEY_9              }
  { A                   0x41                   KEY_A              }
  { B                   0x42                   KEY_B              }
  { C                   0x43                   KEY_C              }
  { D                   0x44                   KEY_D              }
  { E                   0x45                   KEY_E              }
  { F                   0x46                   KEY_F              }
  { G                   0x47                   KEY_G              }
  { H                   0x48                   KEY_H              }
  { I                   0x49                   KEY_I              }
  { J                   0x4A                   KEY_J              }
  { K                   0x4B                   KEY_K              }
  { L                   0x4C                   KEY_L              }
  { M                   0x4D                   KEY_M              }
  { N                   0x4E                   KEY_N              }
  { O                   0x4F                   KEY_O              }
  { P                   0x50                   KEY_P              }
  { Q                   0x51                   KEY_Q              }
  { R                   0x52                   KEY_R              }
  { S                   0x53                   KEY_S              }
  { T                   0x54                   KEY_T              }
  { U                   0x55                   KEY_U              }
  { V                   0x56                   KEY_V              }
  { W                   0x57                   KEY_W              }
  { X                   0x58                   KEY_X              }
  { Y                   0x59                   KEY_Y              }
  { Z                   0x5A                   KEY_Z              }
  { Left_Windows_Key    VK_LWIN                KEY_LEFTMETA       }
  { Right_Windows_Key   VK_RWIN                KEY_RIGHTMETA      }
  { Application_Key     VK_APPS                KEY_COMPOSE        }
  { Sleep               VK_SLEEP               KEY_SLEEP          }
  { Numeric_Keypad_0    VK_NUMPAD0             KEY_KP0            }
  { Numeric_Keypad_1    VK_NUMPAD1             KEY_KP1            }
  { Numeric_Keypad_2    VK_NUMPAD2             KEY_KP2            }
  { Numeric_Keypad_3    VK_NUMPAD3             KEY_KP3            }
  { Numeric_Keypad_4    VK_NUMPAD4             KEY_KP4            }
  { Numeric_Keypad_5    VK_NUMPAD5             KEY_KP5            }
  { Numeric_Keypad_6    VK_NUMPAD6             KEY_KP6            }
  { Numeric_Keypad_7    VK_NUMPAD7             KEY_KP7            }
  { Numeric_Keypad_8    VK_NUMPAD8             KEY_KP8            }
  { Numeric_Keypad_9    VK_NUMPAD9             KEY_KP9            }
  { Multiply            VK_MULTIPLY            KEY_KPASTERISK     }
  { Add                 VK_ADD                 KEY_KPPLUS         }
  { Separator           VK_SEPARATOR           KEY_KPCOMMA        }
  { Subtract            VK_SUBTRACT            KEY_KPMINUS        }
  { Decimal             VK_DECIMAL             KEY_KPDOT          }
  { Divide              VK_DIVIDE              KEY_KPSLASH        }
  { F1                  VK_F1                  KEY_F1             }
  { F2                  VK_F2                  KEY_F2             }
  { F3                  VK_F3                  KEY_F3             }
  { F4                  VK_F4                  KEY_F4             }
  { F5                  VK_F5                  KEY_F5             }
  { F6                  VK_F6                  KEY_F6             }
  { F7                  VK_F7                  KEY_F7             }
  { F8                  VK_F8                  KEY_F8             }
  { F9                  VK_F9                  KEY_F9             }
  { F10                 VK_F10                 KEY_F10            }
  { F11                 VK_F11                 KEY_F11            }
  { F12                 VK_F12                 KEY_F12            }
  { Num_Lock            VK_NUMLOCK             KEY_NUMLOCK        }
  { Scroll_Lock         VK_SCROLL              KEY_SCROLLLOCK     }
  { Left_Shift          VK_LSHIFT              KEY_LEFTSHIFT      }
  { Right_Shift         VK_RSHIFT              KEY_RIGHTSHIFT     }
  { Left_Ctrl           VK_LCONTROL            KEY_LEFTCTRL       }
  { Right_Ctrl          VK_RCONTROL            KEY_RIGHTCTRL      }
  { Left_Alt            VK_LMENU               KEY_LEFTALT        }
  { Right_Alt           VK_RMENU               KEY_RIGHTALT       }
  { Browser_Back        VK_BROWSER_BACK        KEY_BACK           }
  { Browser_Forward     VK_BROWSER_FORWARD     KEY_FORWARD        }
  { Browser_Refresh     VK_BROWSER_REFRESH     KEY_REFRESH        }
  { Browser_Stop        VK_BROWSER_STOP        KEY_STOP           }
  { Browser_Search      VK_BROWSER_SEARCH      KEY_SEARCH         }
  { Browser_Favorites   VK_BROWSER_FAVORITES   KEY_HOMEPAGE       }
  { Browser_Home        VK_BROWSER_HOME        KEY_HOMEPAGE       }
  { Volume_Mute         VK_VOLUME_MUTE         KEY_MUTE           }
  { Volume_Down         VK_VOLUME_DOWN         KEY_VOLUMEDOWN     }
  { Volume_Up           VK_VOLUME_UP           KEY_VOLUMEUP       }
  { Next_Track          VK_MEDIA_NEXT_TRACK    KEY_NEXTSONG       }
  { Previous_Track      VK_MEDIA_PREV_TRACK    KEY_PREVIOUSSONG   }
  { Stop_Media          VK_MEDIA_STOP          KEY_STOPCD         }
  { Play_Pause_Media    VK_MEDIA_PLAY_PAUSE    KEY_PLAYPAUSE      }
  { Launch_Mail         VK_LAUNCH_MAIL         KEY_MAIL           }
  { Launch_Media_Select VK_LAUNCH_MEDIA_SELECT KEY_MEDIA          }
  { Launch_App1         VK_LAUNCH_APP1         KEY_CALC           }
  { Launch_App2         VK_LAUNCH_APP2         KEY_PROG1          }
  { Semicolon           VK_OEM_1               KEY_SEMICOLON      }
  { Plus                VK_OEM_PLUS            KEY_EQUAL          }
  { Comma               VK_OEM_COMMA           KEY_COMMA          }
  { Minus               VK_OEM_MINUS           KEY_MINUS          }
  { Period              VK_OEM_PERIOD          KEY_DOT            }
  { Slash               VK_OEM_2               KEY_SLASH          }
  { Grave_Accent        VK_OEM_3               KEY_GRAVE          }
  { Left_Bracket        VK_OEM_4               KEY_LEFTBRACE      }
  { Backslash           VK_OEM_5               KEY_BACKSLASH      }
  { Right_Bracket       VK_OEM_6               KEY_RIGHTBRACE     }
  { Apostrophe          VK_OEM_7               KEY_APOSTROPHE     }
}

@generate @h_file
{
  `#ifndef OS_HEPHAESTUS_H\n#define OS_HEPHAESTUS_H\n\n`
}

@generate @h_file
{
  `typedef u64 Keyboard_Key;\n`
  `enum\n{\n`
  @foreach(OS_Key_Table) `  Keyboard_Key_$(name),\n`
  `  Keyboard_Key_Count,\n};\n`
  `\n`
  `global const char* KeyboardKeyStrings[] = \n{\n`
  @foreach(OS_Key_Table) `  "$(name)",\n`
  `};\n`
  `\n`

  `#if OS_WINDOWS\n`
  `global u64 _Win32KeyTable[Keyboard_Key_Count] = \n{\n`
  @foreach(OS_Key_Table) `  $(windows_code), /* $(name) */\n`
  `};\n`
  `#endif`
  `// OS_WINDOWS\n`

  `\n`

  `#if OS_LINUX\n`
  `global u64 _LinuxKeyTable[Keyboard_Key_Count] = \n{\n`
  @foreach(OS_Key_Table) `  $(linux_code), /* $(name) */\n`
  `};\n`
  `#endif`
  `// OS_LINUX\n`
}

@generate @h_file
{
  `\n#endif `
  `// OS_HEPHAESTUS_H`
}