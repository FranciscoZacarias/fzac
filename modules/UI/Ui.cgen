@Table UI_Node_Flags_Table (name documentation)
{
  { UI_Node_Flags_Mouse_Clickable  `Makes this node emit a signal when clicked`                                                                       }
  { UI_Node_Flags_Draggable_Panel  `Enables this node to be dragged (and all of their children) by any children or itself, that are draggbale.`       }
  { UI_Node_Flags_Draggable        `Makes this node emit a signal when dragged`                                                                       }
  { UI_Node_Flags_Hoverable        `Makes this node emit a signal when hovered`                                                                       }
  { UI_Node_Flags_Text_Display     `The UI_Node will display the text on the cursor's position and skip the cursor relative to UI_Alignment_Kind`     }
  { UI_Node_Flags_Text_Center_X    `If text is displayed, centers the text horizontally in the node `                                                 }
  { UI_Node_Flags_Text_Center_Y    `If text is displayed, centers the text vertically in the node `                                                   }
  { UI_Node_Flags_Text_Ignore_Clip `Drawing text will simply be aligned by the sizes of it's node `                                                   }
  { UI_Node_Flags_Resizable        `Node can be resized`                                                                                              }
  { UI_Node_Flags_Float_On_Parent  `Overrides parent's alignemnt rules to float on top of parent. Use top left to set the position within the parent` }
}

@Table UI_Signal_Flags_Table (name documentation)
{
  { UI_Signal_Flags_Left_Pressed    `Emits signal if LMB is down`                 }
  { UI_Signal_Flags_Middle_Pressed  `Emits build signal if MMB is down`           }
  { UI_Signal_Flags_Right_Pressed   `Emits signal if RMB is down`                 }
  { UI_Signal_Flags_Left_Clicked    `Emits signal if LMB is clicked`              }
  { UI_Signal_Flags_Middle_Clicked  `Emits signal if MMB is clicked`              }
  { UI_Signal_Flags_Right_Clicked   `Emits signal if RMB is clicked`              }
  { UI_Signal_Flags_Mouse_Hovered   `Emits signal if cursor is hovering`          }
  { UI_Signal_Flags_Close           `Emits a signal that the node wants to close` }
}

@Table UI_Size_Kind_Table (name documentation)
{
  { UI_Size_Kind_Relative `Sets the side of the node to be done relative to the parent's available clip space. I.e. If parent has 100 of height and it already had a node put in with 50 height, and we set the next child node to be 50% relative, this child node's height will be 25, as per the 50 height available. ` }
  { UI_Size_Kind_Fixed    `Sets the side of the node to be fixed (within parent's clip space) `                                                                                                                                                                                                                            }
  { UI_Size_Kind_Copy_X   `Copies the value of X, mutually exclusive with UI_Size_Kind_Copy_Y`                                                                                                                                                                                                                             }
  { UI_Size_Kind_Copy_Y   `Copies the value of Y, mutually exclusive with UI_Size_Kind_Copy_X`                                                                                                                                                                                                                             }
}

@Table UI_Alignment_Kind_Table (name documentation)
{
  { UI_Alignment_Kind_Y     `After a node is placed, the cursor is moved vertically by the height of the node`   }
  { UI_Alignment_Kind_X     `After a node is placed, the cursor is moved horizontally by the width of the node`  }
  { UI_Alignment_Kind_Float `AFter a node is placed, the cursor is not moved`                                    }
}

@Table UI_Layout_Kind_Table (name documentation)
{
  { UI_Layout_Kind_Row          `Layout with fixed height and 100% relative width` }
  { UI_Layout_Kind_Row_Fixed    `Row layout with fixed width`                      }
  { UI_Layout_Kind_Column       `Layout with fixed width and 100% relative height` }
  { UI_Layout_Kind_Column_Fixed `Column layout with fixed height`                  }
}

@Table UI_Color_Theme_Style_Table (name documentation)
{
  { UI_Color_Theme_No_Background      ``                                            } 
  { UI_Color_Theme_White              ``                                            } 
  { UI_Color_Theme_Dark               ``                                            } 
  { UI_Color_Theme_Interactable       `Borders show interactiveness`                } 
  { UI_Color_Theme_Interactable_Solid `Backgrounda and border show interactiveness` } 
}

@Table UI_Stack_Table (name type default_value max debug_bottom_expected documentation)
{
  { parent                 `UI_Node*`            `&UINodeNilSentinel`               8 1 `Parent node of current node`                                                               }
  { top_left                V2s32                `v2s32(0, 0)`                      8 0 `Top left position relative to parent's cursor`                                             }
  { padding_fixed           s32                   0                                 8 0 `Padding in all directions specified the border between node's bounds space and clip space` }
  { size_kind_x             UI_Size_Kind          UI_Size_Kind_Fixed                8 0 `How is width size calculated in this node`                                                 }
  { size_kind_y             UI_Size_Kind          UI_Size_Kind_Fixed                8 0 `How is height size calculated in this node`                                                }
  { size_fixed_x            s32                   64                                8 0 `Width size in pixels`                                                                      }
  { size_fixed_y            s32                   64                                8 0 `Height size in pixels`                                                                     }
  { size_relative_x         f32                  `1.0f`                             8 0 `Width size relative to AVAILABLE space in parent's node. Clamped between 0.0f, and 1.0f`   }
  { size_relative_y         f32                  `1.0f`                             8 0 `Height size relative to AVAILABLE space in parent's node. Clamped between 0.0f, and 1.0f`  }
  { node_center_x           b8                    false                             8 0 `Should this node be centered in the parent's available width?`                             }
  { node_center_y           b8                    false                             8 0 `Should this node be centered in the parent's available height?`                            }
  { alignment_kind          UI_Alignment_Kind     UI_Alignment_Kind_Y               8 0 `What kind of alignment do the child nodes follow?`                                         }
  { node_spacing            s32                   0                                 8 0 `How much spacing is set between the child nodes.`                                          }
  { minimum_width           s32                   0                                 8 0 `Minimum width this node can have`                                                          }
  { minimum_height          s32                   0                                 8 0 `Minimum height this node can have`                                                         }

  { color_theme_style       UI_Color_Theme_Style  UI_Color_Theme_Light              8 0 `Node's colors from UI_Node_COlor_Theme`                                                    }
  { texture                 UI_Texture           `(UI_Texture){-1}`                 8 0 `Display this image on the node`                                                            }
  { text_color              V4f32                `COLOR_CLEAR`                      8 0 `` }
  { background_color        V4f32                `COLOR_CLEAR`                      8 0 `` }
  { background_transparency f32                  `1.0f`                             8 0 `` }
  { border_color            V4f32                `COLOR_CLEAR`                      8 0 `` }
  { border_transparency     f32                  `1.0f`                             8 0 `` }
  { border_thickness        s32                  `1`                                8 0 `Border thickness`                                                                          }
  { corner_roundness_px     s32                  `0.0f`                             8 0 `How many pixels will the border be rounded around.`                                        }
}

