
@Table Stack_Table (name type default_value max debug_bottom_expected documentation)
{
  { parent                 `UI_Node*`            `&UINodeNilSentinel`               8 1 `Parent node of current node`                                                               }
  { top_left                V2s32                `v2s32(0, 0)`                      8 0 `Top left position relative to parent's cursor`                                             }
  { padding_fixed           s32                   0                                 8 0 `Padding in all directions specified the border between node's bounds space and clip space` }
  { size_kind_x             UI_Size_Kind          UI_Size_Kind_Fixed                8 0 `How is width size calculated in this node`                                                 }
  { size_kind_y             UI_Size_Kind          UI_Size_Kind_Fixed                8 0 `How is height size calculated in this node`                                                }
  { size_fixed_x            s32                   64                                8 0 `Width size in pixels`                                                                      }
  { size_fixed_y            s32                   64                                8 0 `Height size in pixels`                                                                     }
  { size_relative_x         f32                  `1.0f`                             8 0 `Width size relative to AVAILABLE space in parent's node. Clamped between 0.0f, and 1.0f`   }
  { size_relative_y         f32                  `1.0f`                             8 0 `Height size relative to AVAILABLE space in parent's node. Clamped between 0.0f, and 1.0f`  }
  { node_center_x           b8                    false                             8 0 `Should this node be centered in the parent's available width?`                             }
  { node_center_y           b8                    false                             8 0 `Should this node be centered in the parent's available height?`                            }
  { alignment_kind          UI_Alignment_Kind     UI_Alignment_Kind_Y               8 0 `What kind of alignment do the child nodes follow?`                                         }
  { node_spacing            s32                   0                                 8 0 `How much spacing is set between the child nodes.`                                          }
  { minimum_width           s32                   0                                 8 0 `Minimum width this node can have`                                                          }
  { minimum_height          s32                   0                                 8 0 `Minimum height this node can have`                                                         }

  { color_theme_style       UI_Color_Theme_Style  UI_Color_Theme_Light              8 0 `Node's colors from UI_Node_COlor_Theme`                                                    }

  { display_image_index     s32                  `-1`                               8 0 `Display this image on the node`                                                            }

  { text_color              V4f32                `COLOR_CLEAR`                      8 0 `` }

  { background_color        V4f32                `COLOR_CLEAR`                      8 0 `` }
  { background_transparency f32                  `1.0f`                             8 0 `` }
  
  { border_color            V4f32                `COLOR_CLEAR`                      8 0 `` }
  { border_transparency     f32                  `1.0f`                             8 0 `` }
  { border_thickness        s32                  `1`                                8 0 `Border thickness`                                                                          }
  
  { corner_roundness_factor f32                  `1.0f`                             8 0 `How much of this color theme's border roundness we're gonna apply to this node.`           }
}

@Generator(ui.cgen.h)
{
  `#ifndef UI_GENERATED_H\n#define UI_GENERATED_H\n\n`

  `\n// Initializes all stack structures\n`
  `#define ui_init_stacks(ctx) \\n`
  @foreach(Stack_Table) `  ctx.$(name)_stack.top_index = 0; ctx.$(name)_stack.bottom_val = $(default_value); \\n`

  `\n`

  `// Creates struct with all UI stacks\n`
  `#define ui_config_stacks \\n`
  `  struct \\n`
  `  { \\n`
	@foreach(Stack_Table) `    struct UI_$(name.capitalize())_stack { $(type) data[$(max)]; u32 top_index; $(type) bottom_val; } $(name)_stack; /* $(documentation) */ \\n`
  `  }\n`

  `\n`

  `// Debug: Serves to check if all stacks are at the bottom by the end of the frame\n`
  `#define ui_debug_stacks_at_bottom \\n`
  @foreach(Stack_Table) `  ui_stack_assert_top_at($(name),$(debug_bottom_expected)); \\n`

  `\n`

  `\n#endif // UI_GENERATED_H`
}

@Generator(ui.cgen.c)
{
  @foreach(Stack_Table) `function void ui_stack_$(name)_init($(type) bot_val) { ui_stack_init($(name), bot_val); }
function void ui_stack_$(name)_push($(type) val) { ui_stack_push($(name), val); }
function $(type) ui_stack_$(name)_pop() { return ui_stack_pop($(name)); }
function $(type) ui_stack_$(name)_top() { return ui_stack_top($(name)); }
function b32  ui_stack_$(name)_is_at_bottom() { return ui_stack_is_at_bottom($(name)); }
function void ui_stack_$(name)_assert_top_at(u32 at) { ui_stack_assert_top_at($(name), at); }
#define ui_$(name)(val) defer_loop(ui_stack_$(name)_push(val), ui_stack_$(name)_pop())\n\n`

}