{
  `#ifndef UI_GENERATED_H\n#define UI_GENERATED_H\n\n`

  // Generate enums
  `typedef enum\n`
  `{\n`
  `  UI_Node_Flags_None = 0,\n`
  @foreach(UI_Node_Flags_Table) `  $(name) = (1 << $(@index)), /* $(documentation) */\n`
  `} UI_Node_Flags;\n`

  `\n`

  `typedef enum\n`
  `{\n`
  `  UI_Signal_Flags_None = 0,\n`
  @foreach(UI_Signal_Flags_Table) `  $(name) = (1 << $(@index)), /* $(documentation) */\n`
  `} UI_Signal_Flags;\n`

  `\n`

  `typedef enum\n`
  `{\n`
  `  UI_Size_Kind_None = 0,\n`
  @foreach(UI_Size_Kind_Table) `  $(name), /* $(documentation) */\n`
  `} UI_Size_Kind;\n`
  `const char *ui_size_kind_to_string[] = {`
   @foreach(UI_Size_Kind_Table) `"$(name)",`
   `};\n`
   `#define ui_size_kind_not_handled(arena, kind) ui_error(Sf(arena, "Unhandled UI_Size_Kind kind: %s", ui_size_kind_to_string[kind]));\n`

   `\n`

  `typedef enum\n`
  `{\n`
  `  UI_Alignment_Kind_None = 0,\n`
  @foreach(UI_Alignment_Kind_Table) `  $(name), /* $(documentation) */\n`
  `} UI_Alignment_Kind;\n`
  `const char *ui_alignment_kind_to_string[] = {`
   @foreach(UI_Alignment_Kind_Table) `"$(name)",`
   `};\n`
   `#define ui_alignment_kind_not_handled(arena, kind) ui_error(Sf(arena, "Unhandled UI_Alignment_Kind kind: %s", ui_alignment_kind_to_string[kind]));\n`

  `\n`

  `typedef enum\n`
  `{\n`
  `  UI_Layout_Kind_None = 0,\n`
  @foreach(UI_Layout_Kind_Table) `  $(name), /* $(documentation) */\n`
  `} UI_Layout_Kind;\n`
  `const char *ui_layout_kind_to_string[] = {`
   @foreach(UI_Layout_Kind_Table) `"$(name)",`
   `};\n`
   `#define ui_layout_kind_not_handled(arena, kind) ui_error(Sf(arena, "Unhandled UI_Layout_Kind kind: %s", ui_layout_kind_to_string[kind]));\n`
   
   `\n`

  `typedef enum\n`
  `{\n`
  `  UI_Color_Theme_Light = 0,\n`
  @foreach(UI_Color_Theme_Style_Table) `  $(name), /* $(documentation) */\n`
  `} UI_Color_Theme_Style;\n`

  // Generate stacks
  `\n// Initializes all stack structures\n`
  `#define ui_init_stacks(ctx) \\n`
  @foreach(UI_Stack_Table) `  ctx.$(name)_stack.top_index = 0; ctx.$(name)_stack.bottom_val = $(default_value); \\n`

  `\n`

  `// Creates struct with all UI stacks\n`
  `#define ui_config_stacks \\n`
  `  struct \\n`
  `  { \\n`
	@foreach(UI_Stack_Table) `    struct UI_$(name.capitalize())_stack { $(type) data[$(max)]; u32 top_index; $(type) bottom_val; } $(name)_stack; /* $(documentation) */ \\n`
  `  }\n`

  `\n`

  `// Debug: Serves to check if all stacks are at the bottom by the end of the frame\n`
  `#define ui_debug_stacks_at_bottom \\n`
  @foreach(UI_Stack_Table) `  ui_stack_assert_top_at($(name),$(debug_bottom_expected)); \\n`

  `\n`

  `\n#endif // UI_GENERATED_H`
}

@Generator(ui.cgen.c)
{
  @foreach(UI_Stack_Table) `function void ui_stack_$(name)_init($(type) bot_val) { ui_stack_init($(name), bot_val); }
function void ui_stack_$(name)_push($(type) val) { ui_stack_push($(name), val); }
function $(type) ui_stack_$(name)_pop() { return ui_stack_pop($(name)); }
function $(type) ui_stack_$(name)_top() { return ui_stack_top($(name)); }
function b32  ui_stack_$(name)_is_at_bottom() { return ui_stack_is_at_bottom($(name)); }
function void ui_stack_$(name)_assert_top_at(u32 at) { ui_stack_assert_top_at($(name), at); }
#define ui_$(name)(val) defer_loop(ui_stack_$(name)_push(val), ui_stack_$(name)_pop())\n\n`

}