@Generator(Vulkan.cgen.h)
{
`#ifndef VULKAN_FUNCTIONS_H
#define VULKAN_FUNCTIONS_H

#define check_vk_result(result, message) if (result != VK_SUCCESS) { log_error("Error: %s, code %x", message, result); }

fz_internal b32 vulkan_load_global_functions();
fz_internal b32 vulkan_load_instance_functions(VkInstance instance);
fz_internal b32 vulkan_load_device_functions(VkDevice device);\n\n`

@foreach(Vulkan_Global_Function_Return_Table)
`fz_global PFN_$(name) __$(name) = NULL;
fz_internal $(return_type)
$(name) $(args)
{
  $(return_type) result = __$(name) $(call_args);
#if DEBUG_VULKAN_CHECK_RESULTS
  check_vk_result(result, "$(name)");
#endif
  return result;
}\n\n`

@foreach(Vulkan_Global_Function_Void_Table)
`fz_global PFN_$(name) __$(name) = NULL;
