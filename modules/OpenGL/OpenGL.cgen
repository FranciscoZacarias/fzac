@Table
OpenGL_Function_Table (return name args call_args)
{
  {  GLuint           glCreateShaderProgramv          `(GLenum type, GLsizei count, const char *const* strings)`                 `(type, count, strings)`            }
  {  GLint            glGetUniformLocation            `(GLuint program, const GLchar *name)`                                     `(program, name)`                   }
  {  GLuint           glCreateProgram                 `(void)`                                                                   `()`                                }
  {  GLenum           glCheckNamedFramebufferStatus   `(GLuint framebuffer, GLenum target)`                                      `(framebuffer, target)`             }
  { `const GLubyte *` glGetString                     `(GLenum name)`                                                            `(name)`                            }
  { `void*`           glMapNamedBufferRange           `(GLuint buffer, GLintptr offset, GLsizeiptr length, GLbitfield access)`   `(buffer, offset, length, access)`  }
  {  GLenum           glGetError                      `(void)`                                                                   `()`                                }
}

@Generator(Opengl.h)
{

  `#ifndef OPENGL_FUNCTIONS_H
#define OPENGL_FUNCTIONS_H

function b32 _os_opengl_load_functions(); /* Loads all opengl functions in the on the code gen Table */\n\n`

  @foreach(OpenGL_Void_Function_Table) 
`typedef void (*PFN$(name)PROC)$(args);
global PFN$(name)PROC __$(name) = NULL;
function inline void
$(name) $(args)
{
  __$(name) $(call_args);
}\n\n`

  @foreach(OpenGL_Function_Table) 
`typedef $(return) (*PFN$(name)PROC)$(args);
global PFN$(name)PROC __$(name) = NULL;
function inline $(return)
$(name) $(args)
{
  return __$(name) $(call_args);
}\n\n`

  `#endif // OPENGL_FUNCTIONS_H`
}

@Generator(Opengl.c)
{
  `function b32\n_opengl_load_functions()\n{\n`

  @foreach(OpenGL_Function_Table)
  `  __$(name) = (PFN$(name)PROC)_load_gl_function("$(name)"); 
  if (!$(name))
  {
    error_box(S("OpenGL"), S("Unable to load opengl function: $(name)"), S("OpenGL.cgen"), 0);
    return false;
  }\n\n`

  @foreach(OpenGL_Void_Function_Table) 
  `  __$(name) = (PFN$(name)PROC)_load_gl_function("$(name)"); 
  if (!__$(name))
  {
    error_box(S("OpenGL"), S("Unable to load opengl function: $(name)"), S("OpenGL.cgen"), 0);
    return false;
  }\n\n`

  `  return true;\n`
  `}`
}