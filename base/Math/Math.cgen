
@Table Vector_Type_Table (type fmt)
{
  { f32 `.2f` }
  { u32 `u`   }
  { s32 `d`   }
}

@Table Rect_Type_Table (type)
{
  { f32 }
  { u32 }
  { s32 }
}

@Generator(Math.cgen.h)
{
  `#ifndef MATH_GENERATED_H\n#define MATH_GENERATED_H\n\n`

  `\n// Vector 2 types\n`
  `// --------------\n`
  @foreach(Vector_Type_Table) 
`typedef struct V2$(type) V2$(type);
struct V2$(type) { $(type) x, y; };
#define v2$(type)(x,y) (V2$(type)){(x),(y)}
#define v2$(type)n(n)  (V2$(type)){(n),(n)}
#define v2$(type)_zero() v2$(type)(0,0)
fz_function V2$(type) v2$(type)_add(V2$(type) a, V2$(type) b);
fz_function V2$(type) v2$(type)_sub(V2$(type) a, V2$(type) b);
fz_function V2$(type) v2$(type)_mul(V2$(type) a, V2$(type) b);
fz_function V2$(type) v2$(type)_scale(V2$(type) v, $(type) s);
fz_function V2$(type) v2$(type)_min(V2$(type) a, V2$(type) b);
fz_function V2$(type) v2$(type)_max(V2$(type) a, V2$(type) b);
fz_function V2$(type) v2$(type)_clamp(V2$(type) v, V2$(type) min, V2$(type) max);
fz_function String    v2$(type)_to_string(Arena* arena, V2$(type) v);\n`

  `\n// Vector 3 types\n`
  `// --------------\n`
  @foreach(Vector_Type_Table) 
`typedef struct V3$(type) V3$(type);
struct V3$(type) { $(type) x, y, z; };
#define v3$(type)(x,y,z) (V3$(type)){(x),(y),(z)}
#define v3$(type)n(n)  (V3$(type)){(n),(n),(n)}
#define v3$(type)_zero() v3$(type)(0,0,0)
fz_function V3$(type) v3$(type)_add(V3$(type) a, V3$(type) b);
fz_function V3$(type) v3$(type)_sub(V3$(type) a, V3$(type) b);
fz_function V3$(type) v3$(type)_mul(V3$(type) a, V3$(type) b);
fz_function V3$(type) v3$(type)_scale(V3$(type) v, $(type) s);
fz_function V3$(type) v3$(type)_min(V3$(type) a, V3$(type) b);
fz_function V3$(type) v3$(type)_max(V3$(type) a, V3$(type) b);
fz_function V3$(type) v3$(type)_clamp(V3$(type) v, V3$(type) min, V3$(type) max);
fz_function String    v3$(type)_to_string(Arena* arena, V3$(type) v);\n`

  `\n// Vector4 types\n`
  `// -------------\n`
  @foreach(Vector_Type_Table)
`
typedef struct V4$(type) V4$(type);
struct V4$(type) { $(type) x, y, z, w; };
#define v4$(type)(x,y,z,w) (V4$(type)){(x),(y),(z),(w)}
#define v4$(type)n(n)  (V4$(type)){(n),(n),(n),(n)}
#define v4$(type)_zero() v4$(type)(0,0,0,0)
fz_function V4$(type) v4$(type)_add(V4$(type) a, V4$(type) b);
fz_function V4$(type) v4$(type)_sub(V4$(type) a, V4$(type) b);
fz_function V4$(type) v4$(type)_mul(V4$(type) a, V4$(type) b);
fz_function V4$(type) v4$(type)_scale(V4$(type) v, $(type) s);
fz_function V4$(type) v4$(type)_min(V4$(type) a, V4$(type) b);
fz_function V4$(type) v4$(type)_max(V4$(type) a, V4$(type) b);
fz_function V4$(type) v4$(type)_clamp(V4$(type) v, V4$(type) min, V4$(type) max);
fz_function String    v4$(type)_to_string(Arena* arena, V4$(type) v);\n`

  `\n// Rect types\n`
  `// ----------\n`
@ foreach(Rect_Type_Table)
`
typedef struct Rect$(type) Rect$(type);
struct Rect$(type) { V2$(type) min; V2$(type) max; };
#define rect$(type)(min,max) (Rect$(type)){(min),(max)}
fz_function Rect$(type) rect$(type)_from_position_size(V2$(type) pos, V2$(type) size);
fz_function V2$(type)   rect$(type)_size(Rect$(type) rect);
fz_function V2$(type)   rect$(type)_center(Rect$(type) rect);
fz_function $(type)     rect$(type)_width(Rect$(type) rect);
fz_function $(type)     rect$(type)_height(Rect$(type) rect);
fz_function $(type)     rect$(type)_area(Rect$(type) rect);
fz_function b32     rect$(type)_contains_point(Rect$(type) rect, V2$(type) point);
fz_function b32     rect$(type)_contains_rect(Rect$(type) a, Rect$(type) b);
fz_function b32     rect$(type)_overlaps(Rect$(type) a, Rect$(type) b);
fz_function Rect$(type) rect$(type)_translate(Rect$(type) rect, V2$(type) offset);
fz_function Rect$(type) rect$(type)_intersection(Rect$(type) a, Rect$(type) b);
fz_function Rect$(type) rect$(type)_union(Rect$(type) a, Rect$(type) b);\n`

  `\n#endif // MATH_GENERATED_H`
}

  @Generator(Math.cgen.c)
  {
    `// V2 Implementation\n`
    @foreach(Vector_Type_Table) `fz_function V2$(type)
v2$(type)_add(V2$(type) a, V2$(type) b)
{
  V2$(type) result = { a.x + b.x, a.y + b.y };
  return result;
}

fz_function V2$(type)
v2$(type)_sub(V2$(type) a, V2$(type) b)
{
  V2$(type) result = { a.x - b.x, a.y - b.y };
  return result;
}

fz_function V2$(type)
v2$(type)_mul(V2$(type) a, V2$(type) b)
{
  V2$(type) result = { a.x * b.x, a.y * b.y };
  return result;
}

fz_function V2$(type)
v2$(type)_scale(V2$(type) v, $(type) s)
{
  V2$(type) result = { v.x * s, v.y * s };
  return result;
}

fz_function V2$(type)
v2$(type)_min(V2$(type) a, V2$(type) b)
{
  V2$(type) result =
  {
    a.x < b.x ? a.x : b.x,
    a.y < b.y ? a.y : b.y
  };
  return result;
}

fz_function V2$(type)
v2$(type)_max(V2$(type) a, V2$(type) b)
{
  V2$(type) result =
  {
    a.x > b.x ? a.x : b.x,
    a.y > b.y ? a.y : b.y
  };
  return result;
}

fz_function V2$(type)
v2$(type)_clamp(V2$(type) v, V2$(type) min, V2$(type) max)
{
  V2$(type) result =
  {
    v.x < min.x ? min.x : (v.x > max.x ? max.x : v.x),
    v.y < min.y ? min.y : (v.y > max.y ? max.y : v.y)
  };
  return result;
}

fz_function String
v2$(type)_to_string(Arena *arena, V2$(type) v)
{
  String result = Sf(arena, "(%%$(fmt), %%$(fmt))", v.x, v.y);
  return result;
}
  `

  `// V3 Implementation\n`
@foreach(Vector_Type_Table)
`fz_function V3$(type)
v3$(type)_add(V3$(type) a, V3$(type) b)
{
  V3$(type) result = { a.x + b.x, a.y + b.y, a.z + b.z };
  return result;
}

fz_function V3$(type)
v3$(type)_sub(V3$(type) a, V3$(type) b)
{
  V3$(type) result = { a.x - b.x, a.y - b.y, a.z - b.z };
  return result;
}

fz_function V3$(type)
v3$(type)_mul(V3$(type) a, V3$(type) b)
{
  V3$(type) result = { a.x * b.x, a.y * b.y, a.z * b.z };
  return result;
}

fz_function V3$(type)
v3$(type)_scale(V3$(type) v, $(type) s)
{
  V3$(type) result = { v.x * s, v.y * s, v.z * s };
  return result;
}

fz_function V3$(type)
v3$(type)_min(V3$(type) a, V3$(type) b)
{
  V3$(type) result = { a.x < b.x ? a.x : b.x,
                       a.y < b.y ? a.y : b.y,
                       a.z < b.z ? a.z : b.z };
  return result;
}

fz_function V3$(type)
v3$(type)_max(V3$(type) a, V3$(type) b)
{
  V3$(type) result = { a.x > b.x ? a.x : b.x,
                       a.y > b.y ? a.y : b.y,
                       a.z > b.z ? a.z : b.z };
  return result;
}

fz_function V3$(type)
v3$(type)_clamp(V3$(type) v, V3$(type) min, V3$(type) max)
{
  V3$(type) result = { v.x < min.x ? min.x : (v.x > max.x ? max.x : v.x),
                       v.y < min.y ? min.y : (v.y > max.y ? max.y : v.y),
                       v.z < min.z ? min.z : (v.z > max.z ? max.z : v.z) };
  return result;
}


fz_function String
v3$(type)_to_string(Arena *arena, V3$(type) v)
{
  String result = Sf(arena, "(%%$(fmt), %%$(fmt), %%$(fmt))", v.x, v.y, v.z);
  return result;
}

`

  `// V4 Implementation\n`
  @foreach(Vector_Type_Table)
`fz_function V4$(type)
v4$(type)_add(V4$(type) a, V4$(type) b)
{
  V4$(type) result = { a.x + b.x, a.y + b.y, a.z + b.z, a.w + b.w };
  return result;
}

fz_function V4$(type)
v4$(type)_sub(V4$(type) a, V4$(type) b)
{
  V4$(type) result = { a.x - b.x, a.y - b.y, a.z - b.z, a.w - b.w };
  return result;
}

fz_function V4$(type)
v4$(type)_mul(V4$(type) a, V4$(type) b)
{
  V4$(type) result = { a.x * b.x, a.y * b.y, a.z * b.z, a.w * b.w };
  return result;
}

fz_function V4$(type)
v4$(type)_scale(V4$(type) v, $(type) s)
{
  V4$(type) result = { v.x * s, v.y * s, v.z * s, v.w * s };
  return result;
}

fz_function V4$(type)
v4$(type)_min(V4$(type) a, V4$(type) b)
{
  V4$(type) result = { a.x < b.x ? a.x : b.x,
                       a.y < b.y ? a.y : b.y,
                       a.z < b.z ? a.z : b.z,
                       a.w < b.w ? a.w : b.w };
  return result;
}

fz_function V4$(type)
v4$(type)_max(V4$(type) a, V4$(type) b)
{
  V4$(type) result = { a.x > b.x ? a.x : b.x,
                       a.y > b.y ? a.y : b.y,
                       a.z > b.z ? a.z : b.z,
                       a.w > b.w ? a.w : b.w };
  return result;
}

fz_function V4$(type)
v4$(type)_clamp(V4$(type) v, V4$(type) min, V4$(type) max)
{
  V4$(type) result = { v.x < min.x ? min.x : (v.x > max.x ? max.x : v.x),
                       v.y < min.y ? min.y : (v.y > max.y ? max.y : v.y),
                       v.z < min.z ? min.z : (v.z > max.z ? max.z : v.z),
                       v.w < min.w ? min.w : (v.w > max.w ? max.w : v.w) };
  return result;
}

fz_function String
v4$(type)_to_string(Arena *arena, V4$(type) v)
{
  String result = Sf(arena, "(%%$(fmt), %%$(fmt), %%$(fmt), %%$(fmt))", v.x, v.y, v.z, v.w);
  return result;
}

\n`

  `// Rect Implementation\n`

  @foreach(Rect_Type_Table)
`
fz_function Rect$(type)
rect$(type)_from_position_size(V2$(type) position, V2$(type) size)
{
  Rect$(type) result = rect$(type)(position, v2$(type)_add(position, size));
  return result;
}

fz_function V2$(type)
rect$(type)_size(Rect$(type) rect)
{
  V2$(type) result = v2$(type)_sub(rect.max, rect.min);
  return result;
}

fz_function V2$(type)
rect$(type)_center(Rect$(type) rect)
{
  V2$(type) size = rect$(type)_size(rect);
  V2$(type) result = v2$(type)(rect.min.x + size.x / 2, rect.min.y + size.y / 2);
  return result;
}

fz_function $(type)
rect$(type)_width(Rect$(type) rect)
{
  $(type) result = rect.max.x - rect.min.x;
  return result;
}

fz_function $(type)
rect$(type)_height(Rect$(type) rect)
{
  $(type) result = rect.max.y - rect.min.y;
  return result;
}

fz_function $(type)
rect$(type)_area(Rect$(type) rect)
{
  $(type) result = rect$(type)_width(rect) * rect$(type)_height(rect);
  return result;
}

fz_function b32
rect$(type)_contains_point(Rect$(type) rect, V2$(type) point)
{
  b32 result = point.x >= rect.min.x &&
               point.x <  rect.max.x &&
               point.y >= rect.min.y &&
               point.y <  rect.max.y;
  return result;
}

fz_function b32
rect$(type)_contains_rect(Rect$(type) a, Rect$(type) b)
{
  b32 result = b.min.x >= a.min.x &&
               b.min.y >= a.min.y &&
               b.max.x <= a.max.x &&
               b.max.y <= a.max.y;
  return result;
}

fz_function b32
rect$(type)_overlaps(Rect$(type) a, Rect$(type) b)
{
  b32 result = a.min.x < b.max.x &&
               a.max.x > b.min.x &&
               a.min.y < b.max.y &&
               a.max.y > b.min.y;
  return result;
}

fz_function Rect$(type)
rect$(type)_translate(Rect$(type) rect, V2$(type) offset)
{
  Rect$(type) result = rect$(type)(v2$(type)_add(rect.min, offset), v2$(type)_add(rect.max, offset));
  return result;
}

fz_function Rect$(type)
rect$(type)_intersection(Rect$(type) a, Rect$(type) b)
{
  Rect$(type) result;
  result.min = v2$(type)_max(a.min, b.min);
  result.max = v2$(type)_min(a.max, b.max);
  if(result.min.x > result.max.x || result.min.y > result.max.y)
  {
    result.min = result.max;
  }
  return result;
}

fz_function Rect$(type)
rect$(type)_union(Rect$(type) a, Rect$(type) b)
{
  Rect$(type) result;
  result.min = v2$(type)_min(a.min, b.min);
  result.max = v2$(type)_max(a.max, b.max);
  return result;
}
`

}