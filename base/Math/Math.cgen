
@Table Vector_Type_Table (type type_upper)
{
  { f32 F32 }
  { u32 U32 }
}

@Generator(Math.generated.h)
{
  `#ifndef MATH_GENERATED_H\n#define MATH_GENERATED_H\n\n`

  `// Vector 2 types\n`
  `// --------------\n`
  @foreach(Vector_Type_Table) 
`typedef struct V2$(type) V2$(type);
struct V2$(type) { $(type) x, y; };
#define v2$(type)(x,y) (V2$(type)){(x),(y)}
#define v2$(type)_zero() v2$(type)(0,0)
function V2$(type) v2$(type)_add(V2$(type) a, V2$(type) b);
function V2$(type) v2$(type)_sub(V2$(type) a, V2$(type) b);
function V2$(type) v2$(type)_mul(V2$(type) a, V2$(type) b);
function V2$(type) v2$(type)_scale(V2$(type) v, $(type) s);
function V2$(type) v2$(type)_min(V2$(type) a, V2$(type) b);
function V2$(type) v2$(type)_max(V2$(type) a, V2$(type) b);
function V2$(type) v2$(type)_clamp(V2$(type) v, V2$(type) min, V2$(type) max);\n\n`

  `// Vector 3 types\n`
  `// --------------\n`
  @foreach(Vector_Type_Table) 
`typedef struct V3$(type) V3$(type);
struct V3$(type) { $(type) x, y, z; };
#define v3$(type)(x,y,z) (V3$(type)){(x),(y),(z)}
#define v3$(type)_zero() v3$(type)(0,0,0)
function V3$(type) v3$(type)_add(V3$(type) a, V3$(type) b);
function V3$(type) v3$(type)_sub(V3$(type) a, V3$(type) b);
function V3$(type) v3$(type)_mul(V3$(type) a, V3$(type) b);
function V3$(type) v3$(type)_scale(V3$(type) v, $(type) s);
function V3$(type) v3$(type)_min(V3$(type) a, V3$(type) b);
function V3$(type) v3$(type)_max(V3$(type) a, V3$(type) b);
function V3$(type) v3$(type)_clamp(V3$(type) v, V3$(type) min, V3$(type) max);\n\n`

  `// Vector4 types\n`
  `// -------------\n`
  @foreach(Vector_Type_Table)
`
typedef struct V4$(type) V4$(type);
struct V4$(type) { $(type) x, y, z, w; };
#define v4$(type)(x,y,z,w) (V4$(type)){(x),(y),(z),(w)}
#define v4$(type)_zero() v4$(type)(0,0,0,0)
function V4$(type) v4$(type)_add(V4$(type) a, V4$(type) b);
function V4$(type) v4$(type)_sub(V4$(type) a, V4$(type) b);
function V4$(type) v4$(type)_mul(V4$(type) a, V4$(type) b);
function V4$(type) v4$(type)_scale(V4$(type) v, $(type) s);
function V4$(type) v4$(type)_min(V4$(type) a, V4$(type) b);
function V4$(type) v4$(type)_max(V4$(type) a, V4$(type) b);
function V4$(type) v4$(type)_clamp(V4$(type) v, V4$(type) min, V4$(type) max);
`

  `#endif // MATH_GENERATED_H`
}

@Generator(Math.generated.c)
{
  `// V2 Implementation\n`
  @foreach(Vector_Type_Table) `function V2$(type)
v2$(type)_add(V2$(type) a, V2$(type) b)
{
  V2$(type) result = { a.x + b.x, a.y + b.y };
  return result;
}

function V2$(type)
v2$(type)_sub(V2$(type) a, V2$(type) b)
{
  V2$(type) result = { a.x - b.x, a.y - b.y };
  return result;
}

function V2$(type)
v2$(type)_mul(V2$(type) a, V2$(type) b)
{
  V2$(type) result = { a.x * b.x, a.y * b.y };
  return result;
}

function V2$(type)
v2$(type)_scale(V2$(type) v, $(type) s)
{
  V2$(type) result = { v.x * s, v.y * s };
  return result;
}

function V2$(type)
v2$(type)_min(V2$(type) a, V2$(type) b)
{
  V2$(type) result =
  {
    a.x < b.x ? a.x : b.x,
    a.y < b.y ? a.y : b.y
  };
  return result;
}

function V2$(type)
v2$(type)_max(V2$(type) a, V2$(type) b)
{
  V2$(type) result =
  {
    a.x > b.x ? a.x : b.x,
    a.y > b.y ? a.y : b.y
  };
  return result;
}

function V2$(type)
v2$(type)_clamp(V2$(type) v, V2$(type) min, V2$(type) max)
{
  V2$(type) result =
  {
    v.x < min.x ? min.x : (v.x > max.x ? max.x : v.x),
    v.y < min.y ? min.y : (v.y > max.y ? max.y : v.y)
  };
  return result;
}

`

  `// V3 Implementation\n`
@foreach(Vector_Type_Table)
`function V3$(type)
v3$(type)_add(V3$(type) a, V3$(type) b)
{
  V3$(type) result = { a.x + b.x, a.y + b.y, a.z + b.z };
  return result;
}

function V3$(type)
v3$(type)_sub(V3$(type) a, V3$(type) b)
{
  V3$(type) result = { a.x - b.x, a.y - b.y, a.z - b.z };
  return result;
}

function V3$(type)
v3$(type)_mul(V3$(type) a, V3$(type) b)
{
  V3$(type) result = { a.x * b.x, a.y * b.y, a.z * b.z };
  return result;
}

function V3$(type)
v3$(type)_scale(V3$(type) v, $(type) s)
{
  V3$(type) result = { v.x * s, v.y * s, v.z * s };
  return result;
}

function V3$(type)
v3$(type)_min(V3$(type) a, V3$(type) b)
{
  V3$(type) result = { a.x < b.x ? a.x : b.x,
                       a.y < b.y ? a.y : b.y,
                       a.z < b.z ? a.z : b.z };
  return result;
}

function V3$(type)
v3$(type)_max(V3$(type) a, V3$(type) b)
{
  V3$(type) result = { a.x > b.x ? a.x : b.x,
                       a.y > b.y ? a.y : b.y,
                       a.z > b.z ? a.z : b.z };
  return result;
}

function V3$(type)
v3$(type)_clamp(V3$(type) v, V3$(type) min, V3$(type) max)
{
  V3$(type) result = { v.x < min.x ? min.x : (v.x > max.x ? max.x : v.x),
                       v.y < min.y ? min.y : (v.y > max.y ? max.y : v.y),
                       v.z < min.z ? min.z : (v.z > max.z ? max.z : v.z) };
  return result;
}

`

  `// V4 Implementation\n`
  @foreach(Vector_Type_Table)
`function V4$(type)
v4$(type)_add(V4$(type) a, V4$(type) b)
{
  V4$(type) result = { a.x + b.x, a.y + b.y, a.z + b.z, a.w + b.w };
  return result;
}

function V4$(type)
v4$(type)_sub(V4$(type) a, V4$(type) b)
{
  V4$(type) result = { a.x - b.x, a.y - b.y, a.z - b.z, a.w - b.w };
  return result;
}

function V4$(type)
v4$(type)_mul(V4$(type) a, V4$(type) b)
{
  V4$(type) result = { a.x * b.x, a.y * b.y, a.z * b.z, a.w * b.w };
  return result;
}

function V4$(type)
v4$(type)_scale(V4$(type) v, $(type) s)
{
  V4$(type) result = { v.x * s, v.y * s, v.z * s, v.w * s };
  return result;
}

function V4$(type)
v4$(type)_min(V4$(type) a, V4$(type) b)
{
  V4$(type) result = { a.x < b.x ? a.x : b.x,
                       a.y < b.y ? a.y : b.y,
                       a.z < b.z ? a.z : b.z,
                       a.w < b.w ? a.w : b.w };
  return result;
}

function V4$(type)
v4$(type)_max(V4$(type) a, V4$(type) b)
{
  V4$(type) result = { a.x > b.x ? a.x : b.x,
                       a.y > b.y ? a.y : b.y,
                       a.z > b.z ? a.z : b.z,
                       a.w > b.w ? a.w : b.w };
  return result;
}

function V4$(type)
v4$(type)_clamp(V4$(type) v, V4$(type) min, V4$(type) max)
{
  V4$(type) result = { v.x < min.x ? min.x : (v.x > max.x ? max.x : v.x),
                       v.y < min.y ? min.y : (v.y > max.y ? max.y : v.y),
                       v.z < min.z ? min.z : (v.z > max.z ? max.z : v.z),
                       v.w < min.w ? min.w : (v.w > max.w ? max.w : v.w) };
  return result;
}
`

}